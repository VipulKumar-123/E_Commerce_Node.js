<%- include ('common/Admin_header.ejs') %>
<!-- Bootstrap Icons -->
<link rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<div class="container-fluid manage-products-page py-5">
    <div class="row">
        <div class="col-12">

            <!-- Page Header -->
            <div class="manage-header mb-4">
                <div>
                    <h2>
                        <i class="bi bi-box-seam me-2"></i>
                        Manage Products
                    </h2>
                    <p>View, manage and update your store products</p>
                </div>

                <a href="/add_product" class="btn add-product-btn">
                    <i class="bi bi-plus-circle me-2"></i>
                    Add Product
                </a>
            </div>

            <!-- Product Table Card -->
            <div class="card product-table-card border-0 shadow-lg">

                <div class="card-header product-table-header">
                    <div>
                        <h5 class="mb-1">
                            <i class="bi bi-list-ul me-2"></i>
                            Product List
                        </h5>
                        <small>All products available in your store</small>
                    </div>
                </div>

                <div class="card-body p-0">

                    <!-- Responsive Table -->
                    <div class="table-responsive">

                        <table class="table manage-product-table align-middle mb-0">

                            <thead>
                                <tr>
                                    <th>ID</th>
                                    <th>Product</th>
                                    <th>Type</th>
                                    <th>Price</th>
                                    <th>Stock</th>
                                    <th>Discount</th>
                                    <th>Photo</th>
                                    <th>Description</th>
                                    <th class="text-center">Action</th>
                                </tr>
                            </thead>

                            <tbody>

                                <% record.forEach((item)=>{ %>

                                <tr>

                                    <!-- ID -->
                                    <td>
                                        <span class="product-id">
                                            #<%= item.id %>
                                        </span>
                                    </td>

                                    <!-- Name -->
                                    <td>
                                        <div class="product-name">
                                            <%= item.name %>
                                        </div>
                                    </td>

                                    <!-- Type -->
                                    <td>
                                        <span class="type-badge">
                                            <%= item.type %>
                                        </span>
                                    </td>

                                    <!-- Price -->
                                    <td>
                                        <strong class="product-price">
                                            ₹<%= item.price %>
                                        </strong>
                                    </td>

                                    <!-- Stock -->
                                    <td>
                                        <% if(item.no_stock > 10) { %>

                                            <span class="stock-badge stock-good">
                                                <i class="bi bi-check-circle me-1"></i>
                                                <%= item.no_stock %>
                                            </span>

                                        <% } else if(item.no_stock > 0) { %>

                                            <span class="stock-badge stock-low">
                                                <i class="bi bi-exclamation-circle me-1"></i>
                                                <%= item.no_stock %>
                                            </span>

                                        <% } else { %>

                                            <span class="stock-badge stock-out">
                                                <i class="bi bi-x-circle me-1"></i>
                                                Out of Stock
                                            </span>

                                        <% } %>
                                    </td>

                                    <!-- Discount -->
                                    <td>
                                        <span class="discount-badge">
                                            <%= item.discount %>%
                                        </span>
                                    </td>

                                    <!-- Photo -->
                                    <td>
                                        <img
                                            src="product_photo/<%= item.photo %>"
                                            class="product-image"
                                            alt="<%= item.name %>"
                                        />
                                    </td>

                                    <!-- Description -->
                                    <td>
                                        <div class="product-description">
                                            <%= item.description %>
                                        </div>
                                    </td>

                                    <!-- Actions -->
                                    <td>
                                        <div class="action-buttons">

                                            <a
                                                href="/delete_product/<%= item.id %>"
                                                onclick="return confirm('Are You Sure?');"
                                                class="btn delete-btn"
                                                title="Delete Product"
                                            >
                                                <i class="bi bi-trash3"></i>
                                                Delete
                                            </a>

                                            <a
                                                href=""
                                                class="btn update-btn"
                                                title="Update Product"
                                            >
                                                <i class="bi bi-pencil-square"></i>
                                                Update
                                            </a>

                                        </div>
                                    </td>

                                </tr>

                                <% }) %>

                            </tbody>

                        </table>

                    </div>

                </div>
            </div>

        </div>
    </div>
</div>


<%- include ('common/footer.ejs') %>