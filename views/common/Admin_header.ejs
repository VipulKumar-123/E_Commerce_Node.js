<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%=title%></title>
      <link rel="stylesheet" href="../../static/css/my.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
</head>
<body>
    <header>

    <nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow-sm sticky-top">

    <div class="container-fluid px-4">

        <!-- Logo -->
        <a class="navbar-brand d-flex align-items-center" href="/admin_home">
            <img
                src="../../static/images/logo.png"
                width="60"
                height="60"
                class="rounded-circle border border-warning"
                alt="ShopEase Logo"
            >

            <span class="ms-2 fw-bold text-white">
                Shop<span class="text-warning">Ease</span>
                <small class="d-block text-secondary"
                       style="font-size: 11px;">
                    Admin Panel
                </small>
            </span>
        </a>


        <!-- Mobile Toggle -->
        <button
            class="navbar-toggler"
            type="button"
            data-bs-toggle="collapse"
            data-bs-target="#adminNavbar"
            aria-controls="adminNavbar"
            aria-expanded="false"
            aria-label="Toggle navigation"
        >
            <span class="navbar-toggler-icon"></span>
        </button>


        <!-- Navbar Content -->
        <div
            class="collapse navbar-collapse"
            id="adminNavbar"
        >

            <!-- Admin Menu -->
            <ul class="navbar-nav mx-auto mb-2 mb-lg-0">

                <!-- Home -->
                <li class="nav-item">
                    <a
                        class="nav-link active px-3 fw-semibold"
                        href="/admin_home"
                    >
                        <i class="bi bi-speedometer2 me-1"></i>
                        Home
                    </a>
                </li>


                <!-- Add Product -->
                <li class="nav-item">
                    <a
                        class="nav-link px-3 fw-semibold"
                        href="/add_product"
                    >
                        <i class="bi bi-plus-circle me-1"></i>
                        Add Product
                    </a>
                </li>


                <!-- Manage Product -->
                <li class="nav-item">
                    <a
                        class="nav-link px-3 fw-semibold"
                        href="/Manage_product"
                    >
                        <i class="bi bi-box-seam me-1"></i>
                        Manage Product
                    </a>
                </li>


                <!-- Manage Customer -->
                <li class="nav-item">
                    <a
                        class="nav-link px-3 fw-semibold"
                        href="/manage_customer"
                    >
                        <i class="bi bi-people me-1"></i>
                        Customers
                    </a>
                </li>


                <!-- Inbox -->
                <li class="nav-item">
                    <a
                        class="nav-link px-3 fw-semibold"
                        href="/Enquiry"
                    >
                        <i class="bi bi-envelope me-1"></i>
                        Inbox
                    </a>
                </li>


                <!-- Signout -->
                <li class="nav-item ms-lg-2">

                    <a
                        class="btn btn-warning text-dark fw-semibold px-3"
                        href="/admin_logout"
                    >
                        <i class="bi bi-box-arrow-right me-1"></i>
                        Signout
                    </a>

                </li>

            </ul>


            <!-- Search -->
            <form
                class="d-flex admin-search"
                role="search"
            >

                <input
                    class="form-control me-2"
                    type="search"
                    placeholder="Search..."
                    aria-label="Search"
                >

                <button
                    class="btn btn-outline-warning"
                    type="submit"
                >
                    <i class="bi bi-search"></i>
                </button>

            </form>

        </div>

    </div>

</nav>
    </header>
   <main>