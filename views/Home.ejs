   <!-- =========================
     HERO CAROUSEL
========================= -->
<section class="hero-section">

    <div id="shopEaseCarousel"
         class="carousel slide carousel-fade"
         data-bs-ride="carousel"
         data-bs-interval="4000">

        <!-- Indicators -->
        <div class="carousel-indicators">

            <button type="button"
                    data-bs-target="#shopEaseCarousel"
                    data-bs-slide-to="0"
                    class="active"
                    aria-current="true"
                    aria-label="Slide 1">
            </button>

            <button type="button"
                    data-bs-target="#shopEaseCarousel"
                    data-bs-slide-to="1"
                    aria-label="Slide 2">
            </button>

            <button type="button"
                    data-bs-target="#shopEaseCarousel"
                    data-bs-slide-to="2"
                    aria-label="Slide 3">
            </button>

        </div>


        <!-- Carousel Items -->
        <div class="carousel-inner">

            <!-- Slide 1 -->
            <div class="carousel-item active">

                <img src="../static/images/3.jpg"
                     class="d-block w-100 hero-image"
                     alt="ShopEase Shopping">

                <div class="carousel-caption custom-caption">

                    <span class="hero-tag">
                        <i class="bi bi-stars me-1"></i>
                        Welcome to ShopEase
                    </span>

                    <h1>
                        Everything You Need,
                        <span>All in One Place</span>
                    </h1>

                    <p>
                        Discover quality products at amazing prices.
                        Shop smarter and enjoy a better shopping experience.
                    </p>

                    <a href="#featured-products"
                       class="btn hero-btn">
                        Shop Now
                        <i class="bi bi-arrow-right ms-2"></i>
                    </a>

                </div>

            </div>


            <!-- Slide 2 -->
            <div class="carousel-item">

                <img src="../static/images/2.avif"
                     class="d-block w-100 hero-image"
                     alt="Latest Products">

                <div class="carousel-caption custom-caption">

                    <span class="hero-tag">
                        <i class="bi bi-lightning-charge-fill me-1"></i>
                        New Collection
                    </span>

                    <h1>
                        Discover
                        <span>Something New</span>
                    </h1>

                    <p>
                        Explore our latest products and find
                        something perfect for you.
                    </p>

                    <a href="#categories"
                       class="btn hero-btn">
                        Explore Now
                        <i class="bi bi-arrow-right ms-2"></i>
                    </a>

                </div>

            </div>


            <!-- Slide 3 -->
            <div class="carousel-item">

                <img src="../static/images/1.avif"
                     class="d-block w-100 hero-image"
                     alt="Special Offers">

                <div class="carousel-caption custom-caption">

                    <span class="hero-tag">
                        <i class="bi bi-tag-fill me-1"></i>
                        Special Offers
                    </span>

                    <h1>
                        Great Products.
                        <span>Better Prices.</span>
                    </h1>

                    <p>
                        Get exciting deals and offers on selected
                        products for a limited time.
                    </p>

                    <a href="#offers"
                       class="btn hero-btn">
                        View Offers
                        <i class="bi bi-arrow-right ms-2"></i>
                    </a>

                </div>

            </div>

        </div>


        <!-- Previous Button -->
        <button class="carousel-control-prev"
                type="button"
                data-bs-target="#shopEaseCarousel"
                data-bs-slide="prev">

            <span class="carousel-control-prev-icon"></span>

            <span class="visually-hidden">
                Previous
            </span>

        </button>


        <!-- Next Button -->
        <button class="carousel-control-next"
                type="button"
                data-bs-target="#shopEaseCarousel"
                data-bs-slide="next">

            <span class="carousel-control-next-icon"></span>

            <span class="visually-hidden">
                Next
            </span>

        </button>

    </div>

</section>



