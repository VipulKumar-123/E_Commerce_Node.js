        </div>


        <div class="map-box">

            <div class="map-content">

                <i class="bi bi-geo-alt-fill display-3 text-warning"></i>

                <h4 class="fw-bold mt-3">
                    ShopEase Office
                </h4>

                <p class="text-muted">
                    Sector 22, Chandigarh, India
                </p>

                <a
                    href="https://www.google.com/maps/search/?api=1&query=Sector+22+Chandigarh"
                    target="_blank"
